rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function userRole(uid) {
   return get(/databases/$(database)/documents/users/$(uid)).data.role;
  }
  function patientOwner(patientUid) {
   return signedIn() && request.auth.uid == patientUid &&
    exists(/databases/$(database)/documents/patients/$(patientUid)) &&
    get(/databases/$(database)/documents/patients/$(patientUid)).data.ownerUid == request.auth.uid;
  }
  function linkedCaregiver(patientUid) {
   return signedIn() &&
    exists(/databases/$(database)/documents/patients/$(patientUid)) &&
    request.auth.uid in get(/databases/$(database)/documents/patients/$(patientUid)).data.caregiverUids;
  }
  function validPairingClaim(patientUid) {
   let claim = getAfter(/databases/$(database)/documents/pairingClaims/$(request.auth.uid));
   let code = getAfter(/databases/$(database)/documents/pairingCodes/$(claim.data.code));
   return signedIn() &&
    userRole(request.auth.uid) == 'caregiver' &&
    claim.data.patientUid == patientUid &&
    claim.data.caregiverUid == request.auth.uid &&
    code.data.patientUid == patientUid &&
    code.data.usedBy == request.auth.uid;
  }

  match /users/{uid} {
   // Own account profile only. A role can be chosen on creation, but cannot be changed later.
   allow read: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn() && request.auth.uid == uid &&
    request.resource.data.uid == uid &&
    request.resource.data.role in ['patient','caregiver'] &&
    request.resource.data.email is string &&
    request.resource.data.displayName is string &&
    request.resource.data.displayName.size() > 0 &&
    request.resource.data.keys().hasOnly(['uid','email','displayName','role','createdAt']) &&
    request.resource.data.createdAt == request.time;
   allow update, delete: if false;
   match /fcmTokens/{tokenId} {
    allow read: if signedIn() && request.auth.uid == uid;
    allow create, update: if signedIn() && request.auth.uid == uid &&
     request.resource.data.token is string &&
     request.resource.data.token.size() >= 20 &&
     request.resource.data.token.size() <= 4096 &&
     request.resource.data.platform == 'android' &&
     request.resource.data.updatedAt == request.time &&
     request.resource.data.keys().hasOnly(['token','platform','updatedAt']);
    allow delete: if signedIn() && request.auth.uid == uid;
   }
  }

  match /patients/{patientUid} {
   // A patient owns exactly their own record. Only the owner or linked caregivers can read it.
   allow create: if signedIn() && request.auth.uid == patientUid &&
    userRole(request.auth.uid) == 'patient' &&
    request.resource.data.ownerUid == request.auth.uid &&
    request.resource.data.displayName is string &&
    request.resource.data.caregiverUids is list &&
    request.resource.data.caregiverUids.size() == 0 &&
    request.resource.data.deviceStatus == 'not_connected' &&
    request.resource.data.createdAt == request.time &&
    request.resource.data.updatedAt == request.time &&
    request.resource.data.keys().hasOnly(['ownerUid','displayName','caregiverUids','deviceStatus','createdAt','updatedAt']);
   allow read: if patientOwner(patientUid) || linkedCaregiver(patientUid);

   allow update: if
    (patientOwner(patientUid) &&
     request.resource.data.ownerUid == resource.data.ownerUid &&
     request.resource.data.caregiverUids == resource.data.caregiverUids &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLocation','lastSeenAt','deviceStatus','updatedAt'])) ||
    (validPairingClaim(patientUid) &&
     request.resource.data.ownerUid == resource.data.ownerUid &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caregiverUids']) &&
     request.resource.data.caregiverUids is list &&
     request.resource.data.caregiverUids.size() <= 2 &&
     request.resource.data.caregiverUids.hasAll(resource.data.caregiverUids) &&
     !(request.auth.uid in resource.data.caregiverUids) &&
     request.auth.uid in request.resource.data.caregiverUids);
   allow delete: if false;

   match /locations/{locationId} {
    allow read: if patientOwner(patientUid) || linkedCaregiver(patientUid);
    allow create: if patientOwner(patientUid) &&
     request.resource.data.keys().hasOnly(['latitude','longitude','accuracyM','recordedAt']) &&
     request.resource.data.latitude is number &&
     request.resource.data.longitude is number &&
     request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 &&
     request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180 &&
     request.resource.data.recordedAt == request.time;
    allow update, delete: if false;
   }

   match /alerts/{alertId} {
    allow read: if patientOwner(patientUid) || linkedCaregiver(patientUid);
    allow create: if patientOwner(patientUid) &&
     request.resource.data.type in ['sos','system','obstacle','device_offline'] &&
     request.resource.data.message is string &&
     request.resource.data.message.size() <= 500 &&
     request.resource.data.createdAt == request.time &&
     request.resource.data.keys().hasOnly(['type','message','createdAt','latitude','longitude','deliveryStatus']);
    allow update, delete: if false;
   }
  }

  match /pairingCodes/{code} {
   // Exact get only; no listing or enumeration. Patient can check a code document they own
   // (or verify a non-existing random code ID); caregivers may read only live unused codes.
   allow get: if signedIn() &&
    ((userRole(request.auth.uid) == 'patient' &&
      (!exists(/databases/$(database)/documents/pairingCodes/$(code)) ||
       resource.data.patientUid == request.auth.uid)) ||
     (userRole(request.auth.uid) == 'caregiver' &&
      (!exists(/databases/$(database)/documents/pairingCodes/$(code)) ||
       (resource.data.usedBy == null && resource.data.expiresAt > request.time))));
   allow list: if false;

   allow create: if signedIn() &&
    request.auth.uid == request.resource.data.patientUid &&
    userRole(request.auth.uid) == 'patient' &&
    code.matches('^[0-9]{8}$') &&
    exists(/databases/$(database)/documents/patients/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/patients/$(request.auth.uid)).data.ownerUid == request.auth.uid &&
    get(/databases/$(database)/documents/patients/$(request.auth.uid)).data.caregiverUids is list &&
    get(/databases/$(database)/documents/patients/$(request.auth.uid)).data.caregiverUids.size() < 2 &&
    request.resource.data.patientUid == request.auth.uid &&
    request.resource.data.createdAt == request.time &&
    request.resource.data.expiresAt > request.time &&
    request.resource.data.expiresAt <= request.time + duration.value(10, 'm') &&
    request.resource.data.usedBy == null &&
    request.resource.data.usedAt == null &&
    request.resource.data.keys().hasAll(['patientUid','createdAt','expiresAt','usedBy','usedAt']) &&
    request.resource.data.keys().hasOnly(['patientUid','createdAt','expiresAt','usedBy','usedAt']);

   // Code consumption must be atomic with creation of the caregiver claim and patient link.
   allow update: if signedIn() &&
    userRole(request.auth.uid) == 'caregiver' &&
    resource.data.usedBy == null && resource.data.expiresAt > request.time &&
    request.resource.data.patientUid == resource.data.patientUid &&
    request.resource.data.createdAt == resource.data.createdAt &&
    request.resource.data.expiresAt == resource.data.expiresAt &&
    request.resource.data.usedBy == request.auth.uid &&
    request.resource.data.usedAt == request.time &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','usedAt']) &&
    getAfter(/databases/$(database)/documents/pairingClaims/$(request.auth.uid)).data.patientUid == resource.data.patientUid &&
    getAfter(/databases/$(database)/documents/pairingClaims/$(request.auth.uid)).data.code == code;
   allow delete: if false;
  }

  match /pairingClaims/{caregiverUid} {
   allow get: if signedIn() && request.auth.uid == caregiverUid;
   allow list: if false;
   allow create: if signedIn() &&
    request.auth.uid == caregiverUid &&
    userRole(request.auth.uid) == 'caregiver' &&
    request.resource.data.caregiverUid == request.auth.uid &&
    request.resource.data.patientUid is string &&
    request.resource.data.patientUid != request.auth.uid &&
    request.resource.data.code is string &&
    request.resource.data.createdAt == request.time &&
    request.resource.data.keys().hasOnly(['patientUid','caregiverUid','code','createdAt']) &&
    exists(/databases/$(database)/documents/pairingCodes/$(request.resource.data.code)) &&
    get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.code)).data.patientUid == request.resource.data.patientUid &&
    get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.code)).data.usedBy == null &&
    get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.code)).data.expiresAt > request.time &&
    exists(/databases/$(database)/documents/patients/$(request.resource.data.patientUid)) &&
    get(/databases/$(database)/documents/patients/$(request.resource.data.patientUid)).data.caregiverUids is list &&
    get(/databases/$(database)/documents/patients/$(request.resource.data.patientUid)).data.caregiverUids.size() < 2 &&
    !(request.auth.uid in get(/databases/$(database)/documents/patients/$(request.resource.data.patientUid)).data.caregiverUids);
   allow update, delete: if false;
  }
 }
}
